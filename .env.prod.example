# Production environment. Copy to .env.prod and fill in:
#
#   cp .env.prod.example .env.prod
#
# Consumed by `just prod-up` (docker compose --env-file .env.prod). .env.prod is
# git-ignored. There is deliberately no AUTH_DISABLED here: the stack sets
# ENV=production, and config.py refuses to start if AUTH_DISABLED is set anyway,
# so turning development auth on takes a conscious edit in two places.

# --- PostgreSQL --------------------------------------------------------------
# The data volume starts empty; the backend entrypoint creates the schema.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Flask -------------------------------------------------------------------
# Required by config.py. Nothing reads it yet (the app sets no cookies and uses
# no Flask session), but startup fails without it.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# --- Cloudflare Access: the app's only identity source -----------------------
# Zero Trust -> Access -> Applications -> your app -> Overview, or the JWT's
# `iss`/`aud` after a test request. Every /api call is verified against these.
CF_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_AUD=

# --- Cloudflare Tunnel -------------------------------------------------------
# Zero Trust -> Networks -> Tunnels -> your tunnel -> Install connector -> Docker.
# The public hostname for that tunnel must point at http://frontend:80, which
# serves the app and proxies /api to the backend on the same origin.
TUNNEL_TOKEN=
