# Copy to .env for local development: cp .env.example .env
#
# Matches the `db` service in the repository-root docker-compose.yml, which
# publishes PostgreSQL on 127.0.0.1:5434.
DATABASE_URL=postgresql+psycopg://postgres:secret@localhost:5434/codeforces_gym_db

# Flask session signing key. Any random string works locally.
SECRET_KEY=dev-only-change-me

# Local development: skip Cloudflare Access verification.
# Only honoured when ENV=development, and then DEV_EMAIL says who you are.
ENV=development
AUTH_DISABLED=1
DEV_EMAIL=dev@example.com

# Set both when deploying behind Cloudflare Access (ENV unset or "production").
CF_TEAM_DOMAIN=""
CF_AUD=""
