# Production image: build the SPA with the static adapter and serve it, plus
# /api, from nginx.
#
# The dev image (Dockerfile) stays as it is: bind-mounted source and the Vite
# dev server, which is what docker-compose.yml runs.
FROM oven/bun:1.4.2 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bun --bun run build

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
